!03_Final_Panels/04_Figure_4/04_B/module_mappings.csv
!03_Final_Panels/04_Figure_4/04_E/momac_marker_summary.csv
!03_Final_Panels/05_Figure_5/05_F/nfkb_rankings_flipped.csv
!03_Final_Panels/05_Figure_5/05_F/nfkb_rankings_used.csv
!03_Final_Panels/05_Figure_5/05_GSEA_Summary/gsea_data/gsea_combined_5types.csv
