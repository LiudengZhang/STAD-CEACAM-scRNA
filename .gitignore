# Data files (not included in repo - see Data Availability)
*.h5ad
*.loom
*.feather
*.pkl
*.rds
*.RData

# Intermediate results
*.csv
*.tsv

# Except the supplementary tables: three revision scripts and
# verify_numbers.py read the cohort and signature definitions out of
# them, so the repository is not runnable without them. 60 KB in total.
!05_Manuscript/04_Tables/*.csv


# Figure outputs (regenerated by scripts)
*.png
*.svg
*.pdf

# GSEA artifacts
*.log
*.rnk

# Large database files (download separately - see README)
*.tbl

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db


